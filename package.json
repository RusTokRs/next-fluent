{
  "name": "next-fluent",
  "version": "0.1.0",
  "description": "Modern, lightweight Project Fluent (Mozilla) localization library for Next.js App Router (RSC + Client Components)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./middleware": {
      "types": "./dist/middleware.d.ts",
      "default": "./dist/middleware.js"
    },
    "./navigation": {
      "types": "./dist/navigation.d.ts",
      "default": "./dist/navigation.js"
    },
    "./routing": {
      "types": "./dist/routing.d.ts",
      "default": "./dist/routing.js"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "default": "./dist/plugin.js"
    },
    "./factory": {
      "types": "./dist/factory.d.ts",
      "default": "./dist/factory.js"
    },
    "./typegen": {
      "types": "./dist/typegen.d.ts",
      "default": "./dist/typegen.js"
    },
    "./utils": {
      "types": "./dist/utils.d.ts",
      "default": "./dist/utils.js"
    },
    "./formatter": {
      "types": "./dist/formatter.d.ts",
      "default": "./dist/formatter.js"
    }
  },
  "sideEffects": false,
  "bin": {
    "next-fluent": "bin/next-fluent.mjs"
  },
  "files": [
    "dist",
    "bin",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test ./test/*.test.mjs",
    "prepack": "npm run build",
    "check-dist": "npm run build && git diff --ignore-space-at-eol --exit-code dist/",
    "ci": "npm run build && npm run check-dist && npm run typecheck && npm test",
    "verify": "npm run build && npm run typecheck && npm test"
  },
  "dependencies": {
    "@fluent/bundle": "0.19.1",
    "@fluent/syntax": "^0.19.0"
  },
  "peerDependencies": {
    "next": ">=15.0.0 <17.0.0",
    "react": ">=19.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "esbuild": "^0.28.2",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "7.0.2"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/next-fluent/next-fluent.git"
  },
  "bugs": {
    "url": "https://github.com/next-fluent/next-fluent/issues"
  },
  "homepage": "https://github.com/next-fluent/next-fluent#readme",
  "keywords": [
    "nextjs",
    "fluent",
    "i18n",
    "localization",
    "l10n",
    "project-fluent",
    "mozilla-fluent",
    "react",
    "app-router",
    "rsc"
  ]
}
