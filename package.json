{
  "name": "next-fluent",
  "version": "0.1.0",
  "description": "Modern, lightweight Project Fluent (Mozilla) localization library for Next.js App Router (RSC + Client Components)",
  "type": "module",
  "main": "./dist/index-browser.js",
  "types": "./dist/index-browser.d.ts",
  "exports": {
    ".": {
      "react-server": {
        "types": "./dist/index-server.d.ts",
        "default": "./dist/index-server.js"
      },
      "types": "./dist/index-browser.d.ts",
      "browser": "./dist/index-browser.js",
      "default": "./dist/index-browser.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./server-provider": {
      "types": "./dist/server-provider.d.ts",
      "default": "./dist/server-provider.js"
    },
    "./middleware": {
      "types": "./dist/middleware.d.ts",
      "default": "./dist/middleware.js"
    },
    "./navigation": {
      "types": "./dist/navigation.d.ts",
      "default": "./dist/navigation.js"
    },
    "./routing": {
      "types": "./dist/routing.d.ts",
      "default": "./dist/routing.js"
    },
    "./plugin": {
      "import": {
        "types": "./dist/plugin.d.ts",
        "default": "./dist/plugin.js"
      },
      "require": {
        "types": "./plugin.d.cts",
        "default": "./dist/cjs/plugin.cjs"
      },
      "default": "./dist/plugin.js"
    },
    "./factory": {
      "types": "./dist/factory.d.ts",
      "default": "./dist/factory.js"
    },
    "./typegen": {
      "types": "./dist/typegen.d.ts",
      "default": "./dist/typegen.js"
    },
    "./catalog": {
      "types": "./dist/catalog.d.ts",
      "default": "./dist/catalog.js"
    },
    "./catalog-io": {
      "types": "./dist/catalog-io.d.ts",
      "default": "./dist/catalog-io.js"
    },
    "./pseudo": {
      "types": "./dist/pseudo.d.ts",
      "default": "./dist/pseudo.js"
    },
    "./messages": {
      "types": "./dist/pick-messages.d.ts",
      "default": "./dist/pick-messages.js"
    },
    "./check": {
      "types": "./dist/check.d.ts",
      "default": "./dist/check.js"
    },
    "./usage": {
      "types": "./dist/usage.d.ts",
      "default": "./dist/usage.js"
    },
    "./utils": {
      "types": "./dist/utils.d.ts",
      "default": "./dist/utils.js"
    },
    "./formatter": {
      "types": "./dist/formatter.d.ts",
      "default": "./dist/formatter.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=22.0.0"
  },
  "bin": {
    "next-fluent": "bin/next-fluent.mjs"
  },
  "files": [
    "dist",
    "bin",
    "plugin.d.cts",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:types": "node ./bin/next-fluent.mjs typegen --input test/types/messages.ftl --output test/types/messages.d.ts && tsc -p test/types/tsconfig.json",
    "test:next": "npm run build && node ./scripts/test-next-integration.mjs",
    "test": "node --test \"test/*.test.mjs\"",
    "test:watch": "node --test --watch \"test/*.test.mjs\"",
    "test:next:browser": "npm run build && node ./scripts/test-next-integration.mjs --browser",
    "prepack": "npm run build",
    "check-dist": "npm run build && git diff --ignore-space-at-eol --exit-code dist/",
    "size": "node ./scripts/size-budget.mjs",
    "test:edge": "node ./scripts/check-edge-runtime.mjs",
    "ci": "npm run build && npm run check-dist && npm run lint && npm run typecheck && npm run test:edge && npm test && npm run test:consumer && npm run size",
    "check": "npm run ci && npm run test:types && npm run test:next && npm run test:next:16",
    "verify": "npm run build && npm run lint && npm run typecheck && npm run test:types && npm test",
    "test:consumer": "node ./scripts/test-consumer.mjs",
    "test:next:16": "npm run build && NEXT_FLUENT_NEXT_VERSION=16 node ./scripts/test-next-integration.mjs",
    "prepublishOnly": "npm run check"
  },
  "dependencies": {
    "@fluent/bundle": "0.19.1",
    "@fluent/syntax": "^0.19.0"
  },
  "peerDependencies": {
    "next": ">=15.3.0 <17.0.0",
    "react": ">=19.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^6.1.1",
    "globals": "^17.12.0",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1"
  },
  "overrides": {
    "postcss": "^8.5.23"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RusTokRs/next-fluent.git"
  },
  "bugs": {
    "url": "https://github.com/RusTokRs/next-fluent/issues"
  },
  "homepage": "https://github.com/RusTokRs/next-fluent#readme",
  "keywords": [
    "nextjs",
    "fluent",
    "i18n",
    "localization",
    "l10n",
    "project-fluent",
    "mozilla-fluent",
    "react",
    "app-router",
    "rsc"
  ]
}
